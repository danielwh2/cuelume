{
  "name": "cuelume",
  "version": "0.2.5",
  "description": "Curated interaction sounds for the web — synthesized live with zero runtime dependencies.",
  "keywords": [
    "web-audio",
    "sound",
    "ui-sounds",
    "sound-effects",
    "interaction-feedback",
    "interface-sounds",
    "hover",
    "click",
    "synthesis"
  ],
  "license": "MIT",
  "author": "Daniel Belyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielwh2/cuelume.git"
  },
  "bugs": {
    "url": "https://github.com/danielwh2/cuelume/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/sounds/themes.d.ts",
      "import": "./dist/sounds/themes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:browser": "npm run build && CUELUME_BROWSER_REQUIRED=1 node --test test/browser.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0",
    "typescript": "^5.6.0"
  }
}
